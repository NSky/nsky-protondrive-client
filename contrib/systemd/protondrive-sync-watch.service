# Keeps all synced folders in sync continuously ("protondrive sync --watch").
# Install as a user unit:
#   cp protondrive-sync-watch.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now protondrive-sync-watch.service
#   loginctl enable-linger "$USER"     # optional: keep running while you are logged out
# Logs: journalctl --user -u protondrive-sync-watch -f

[Unit]
Description=Proton Drive sync (watch mode)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/protondrive sync --watch --no-progress
Restart=on-failure
RestartSec=60
# Exit code 3: the Proton session has ended. Run 'protondrive login', then restart the service.
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
