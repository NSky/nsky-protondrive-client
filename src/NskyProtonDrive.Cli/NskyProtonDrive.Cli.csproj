<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>protondrive</AssemblyName>
    <RootNamespace>NskyProtonDrive.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced directly so the app ships exactly this version (the SDK projects only set a minimum). -->
    <PackageReference Include="Proton.Cryptography" Version="$(ProtonCryptographyPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Proton.Drive.Sdk" Version="$(ProtonDriveSdkPackageVersion)" />
    <PackageReference Include="Proton.Drive.Sdk.Account" Version="$(ProtonDriveSdkPackageVersion)" />
  </ItemGroup>

</Project>
