# Runs protondrive-sync.service every 15 minutes, as the user who enabled it.
# Enable for yourself with: protondrive service enable --timer

[Unit]
Description=Proton Drive sync every 15 minutes
Documentation=file://@DOCDIR@/README.md

[Timer]
OnStartupSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
