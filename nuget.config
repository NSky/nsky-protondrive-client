<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-nsky" value="https://nuget.pkg.github.com/NSky/index.json" />
  </packageSources>

  <!-- GitHub Packages requires authentication, even for public packages. Set these environment variables
       (a classic personal access token with the read:packages scope), see README. -->
  <packageSourceCredentials>
    <github-nsky>
      <add key="Username" value="%NUGET_GITHUB_USER%" />
      <add key="ClearTextPassword" value="%NUGET_GITHUB_TOKEN%" />
    </github-nsky>
  </packageSourceCredentials>

  <packageSourceMapping>
    <packageSource key="github-nsky">
      <package pattern="Proton.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
