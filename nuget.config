<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Proton.Cryptography is not published on nuget.org; build it from
         https://github.com/ProtonDriveApps/dotnet-crypto and pack it here (see README). -->
    <add key="local" value="../local-nuget" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Proton.Cryptography" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
