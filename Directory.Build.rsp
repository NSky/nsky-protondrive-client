# Applied to every `dotnet build/restore/run` started from this repository.
#
# `dotnet build` restores with `-restoreProperty` switches, and then MSBuild ignores `-p` properties during
# restore, so every property needed by restore is set both ways.

# The SDK can target either the Go- or Rust-backed Proton.Cryptography package; the fork we publish
# (NSky/proton-dotnet-crypto) is Rust-backed.
-p:CryptoBackend=rust
-restoreProperty:CryptoBackend=rust

# Use this repository's nuget.config for the referenced SDK projects too (the SDK's own nuget.config maps
# Proton.* packages to a feed that is not publicly available).
-p:RestoreConfigFile=%MSBUILDTHISFILEDIRECTORY%nuget.config
-restoreProperty:RestoreConfigFile=%MSBUILDTHISFILEDIRECTORY%nuget.config
