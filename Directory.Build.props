<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <Version>0.2.7</Version>
    <Authors>nSky Labs</Authors>
    <Product>protondrive-client</Product>
    <Description>Proton Drive command-line client with folder sync. Not affiliated with Proton AG. Provided as is, without warranty.</Description>
  </PropertyGroup>

</Project>
