<Project>

  <PropertyGroup>
    <ProtonDriveSdkPackageVersion>0.1.0</ProtonDriveSdkPackageVersion>
    
    <!-- Proton.Cryptography from https://github.com/NSky/proton-dotnet-crypto (GitHub Packages feed). -->
    <ProtonCryptographyPackageVersion>0.40.1</ProtonCryptographyPackageVersion>

    <MicrosoftDataSqlitePackageVersion>10.0.14</MicrosoftDataSqlitePackageVersion>

    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>

    <Version>0.2.1</Version>
    <Authors>NSky Labs</Authors>
    <Product>nsky-protondrive-client</Product>
    <Description>Unofficial, alpha-quality Proton Drive command-line client with folder sync. Not affiliated with Proton AG. Provided as is, without warranty.</Description>
  </PropertyGroup>

</Project>
